---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EssaysChrome from "../../components/essays/EssaysChrome.astro";

const posts = await getCollection("blog");
const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout
  title="Tags"
  description="Every tag across the writing and the notes."
  canonicalPath="/essays/tags/"
  bodyClass="page-essays page-home-photo"
>
  <EssaysChrome />

  <section class="essays-tags essays-shell">
    <p class="essays-kicker">{tags.length} tags · {posts.length} posts</p>
    <h1 class="essays-title">Tags</h1>
    <p class="essays-lede">Every tag across the writing and the notes, most used first.</p>
    <ul class="essays-tags-list">
      {
        tags.map(([tag, count]) => (
          <li>
            <a class="essays-chip" href={`/essays/?${new URLSearchParams({ tag })}`}>
              {tag} <span>{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
