---
import NoteArticle from "../../../components/essays/NoteArticle.astro";
import WritingArticle from "../../../components/essays/WritingArticle.astro";
import { getLegacySlug, getPostUrl } from "../../../lib/posts";
import { isWriting, loadEssays } from "../../../lib/essays";

export async function getStaticPaths() {
  const essays = await loadEssays();
  return essays.posts.map((post) => ({ params: { legacy: getLegacySlug(post) }, props: { post, essays } }));
}

const { post, essays } = Astro.props;
---

{
  isWriting(post) ? (
    <WritingArticle post={post} posts={essays.posts} readingOrder={essays.readingOrder} canonicalPath={getPostUrl(post)} />
  ) : (
    <NoteArticle post={post} notes={essays.notes} canonicalPath={getPostUrl(post)} />
  )
}
