---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadGallery } from "../../lib/gallery";
import "../../styles/photos.css";

const { items, remote } = loadGallery();
const years = [...new Set(items.map((p) => p.year).filter(Boolean))] as string[];
const range = years.length > 1 ? `${years[0]} — ${years.at(-1)}` : (years[0] ?? "");
// Dots follow item order (oldest first, undated last), which is what main.ts relies on.
const timeline = years.map((year) => ({ year, photos: items.filter((item) => item.year === year) }));
const undated = items.filter((item) => !item.year);
if (undated.length > 0) {
  timeline.push({ year: "—", photos: undated });
}
---

<BaseLayout
  title="Photos"
  description={
    remote
      ? "A walk through time: photographs in a 3D corridor, with depth you can look around."
      : "Photographs from public/images — built automatically at compile time."
  }
  canonicalPath="/photos/"
  bodyClass="page-photos"
>
  <script is:inline>
    (function () {
      var root = document.documentElement;
      var view = new URLSearchParams(location.search).get("view");
      var webgl = false;
      try {
        var gl = document.createElement("canvas").getContext("webgl2");
        webgl = !!gl;
        var lose = gl && gl.getExtension("WEBGL_lose_context");
        if (lose) lose.loseContext();
      } catch (e) {}
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var mode = webgl && (view === "3d" || (view !== "grid" && !reduce)) ? "3d" : "grid";
      root.dataset.gallery = mode;
      if (webgl) root.dataset.webgl = "";
      if (mode === "3d") document.body.classList.add("page-home-photo", "gallery-3d");
    })();
  </script>

  <div class="gallery" data-gallery>
    <section class="gallery-stage" aria-label="Photo corridor">
      <div class="gallery-track" data-gallery-track style={{ "--count": items.length }}>
        <div class="gallery-sticky">
          <canvas class="gallery-canvas" data-gallery-canvas aria-hidden="true"></canvas>
          <div class="gallery-vignette" aria-hidden="true"></div>
          <div class="gallery-grain" aria-hidden="true"></div>

          <header class="gallery-intro">
            <p class="gallery-kicker">{items.length} frames · {range}</p>
            <h1 class="gallery-title">Photos</h1>
            <p class="gallery-lede">A walk through time. Move the cursor to look around; click a frame to step inside.</p>
          </header>
          <p class="gallery-scroll-hint" aria-hidden="true"><span></span>Scroll</p>

          <div class="gallery-hud">
            <button type="button" class="gallery-caption" data-gallery-caption hidden>
              <span class="gallery-caption-no" data-caption-no></span>
              <span class="gallery-caption-title" data-caption-title></span>
              <span class="gallery-caption-meta" data-caption-meta></span>
              <span class="gallery-caption-cta">View <span aria-hidden="true">↗</span></span>
            </button>

            <nav class="gallery-timeline" aria-label="Timeline">
              {
                timeline.map((group) => (
                  <div class="gallery-timeline-year">
                    <span class="gallery-timeline-label">{group.year}</span>
                    {group.photos.map((item) => (
                      <button
                        type="button"
                        class="gallery-dot"
                        data-gallery-dot
                        aria-label={`${item.title}${item.place ? `, ${item.place}` : ""}${item.date ? `, ${item.date}` : ""}`}
                        title={item.title}
                      />
                    ))}
                  </div>
                ))
              }
            </nav>

            <a class="gallery-switch" href="?view=grid">Grid view</a>
          </div>

          <div class="gallery-outro" data-gallery-outro inert>
            <p class="gallery-outro-title">To be continued.</p>
            <p class="gallery-outro-links">
              <button type="button" data-gallery-restart>Back to the start ↑</button>
              <a href="?view=grid">See them all at once</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <div class="photos-page gallery-grid">
      <h1 class="sr-only">Photos</h1>

      {
        items.length === 0 ? (
          <p class="photos-empty site-shell">
            {remote ? "No URLs in galleryPhotos yet." : "No image files found in public/images."}
          </p>
        ) : (
          <ul class="photo-wall" role="list" data-photo-wall>
            {items.map((p, index) => (
              <li
                class="photo-tile"
                data-reveal
                style={{
                  "--aspect": p.aspect,
                  "--tile-color": p.color,
                  "--reveal-delay": `${Math.min(index, 8) * 0.04}s`,
                }}
              >
                <button
                  type="button"
                  class="photo-tile-button"
                  data-photo-index={index}
                  aria-label={`View larger: ${p.alt}`}
                >
                  <span class="photo-tile-frame">
                    <img
                      src={p.sm}
                      srcset={p.srcset}
                      sizes={`(max-width: 720px) 100vw, ${Math.round(p.aspect * 32)}vw`}
                      alt={p.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <span class="photo-tile-caption" aria-hidden="true">
                    <span class="photo-tile-title">{p.title}</span>
                    <span class="photo-tile-meta">
                      {[p.place, p.date?.replaceAll("-", ".")].filter(Boolean).join(" · ")}
                    </span>
                  </span>
                </button>
              </li>
            ))}
          </ul>
        )
      }
      <a class="gallery-grid-switch" href="?view=3d">View in 3D <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <dialog class="lightbox" data-lightbox aria-label="Photo viewer">
    <div class="lightbox-stage" data-lightbox-stage>
      <img class="lightbox-img" data-lightbox-img alt="" />
    </div>
    <aside class="lightbox-label" data-lightbox-label>
      <p class="lightbox-label-no" data-label-no></p>
      <h2 class="lightbox-label-title" data-label-title></h2>
      <p class="lightbox-label-meta" data-label-meta></p>
      <dl class="lightbox-label-spec" data-label-spec></dl>
    </aside>
    <div class="lightbox-nav">
      <button type="button" class="lightbox-btn" data-lightbox-prev aria-label="Previous photo">←</button>
      <span class="lightbox-counter" data-lightbox-counter aria-live="polite"></span>
      <button type="button" class="lightbox-btn" data-lightbox-next aria-label="Next photo">→</button>
    </div>
    <button type="button" class="lightbox-close" data-lightbox-close>Close <span aria-hidden="true">✕</span></button>
    <p class="lightbox-hint" aria-hidden="true">Move to look around · ← → to browse · Esc to close</p>
  </dialog>

  <script is:inline type="application/json" id="gallery-data" set:html={JSON.stringify(items).replaceAll("<", "\\u003c")} />
  <script>
    import "../../scripts/gallery/main";
  </script>
</BaseLayout>
